# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Primeira tela depois do login. "/entrar" decide entre PDI e Minds conforme a
# pessoa ter ou não um PDI atribuído. As páginas de sign-in/sign-up também
# passam esse destino na prop `fallbackRedirectUrl`, então o app funciona mesmo
# sem estas duas variáveis — elas existem pra deixar o destino explícito.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/entrar

# API — em dev o Next faz proxy de /api/* pro Fastify local
NEXT_PUBLIC_API_URL=http://localhost:3001
