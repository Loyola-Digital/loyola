# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/loyola_dev

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# CORS
CORS_ORIGIN=http://localhost:3000

# Mind Registry
MINDS_BASE_PATH=./squads

# ClickUp Integration (optional)
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# Notificações push (Web Push / VAPID). Gerar o par com:
#   npx web-push generate-vapid-keys
# O MESMO par tem que estar no Coolify: trocar as chaves invalida toda
# inscrição já feita, e o aparelho não avisa — só para de receber.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@loyoladigital.com
